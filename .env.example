# MineSwap — environment template. COPY to .env.local (local dev) or set the
# same names in the Vercel dashboard (Project > Settings > Environment
# Variables). NEVER commit real values. NEVER paste real values in chat.
#
# Required
BOT_TOKEN=PASTE_FROM_BOTFATHER
BOT_USERNAME=mineswapearnbot
WEBAPP_URL=https://YOUR-PROJECT.vercel.app
DB_HOST=YOUR-TIDB-HOST.tidbcloud.com
DB_PORT=4000
DB_NAME=mineswap
DB_USER=YOUR-TIDB-USER
DB_PASS=PASTE_TIDB_PASSWORD
DB_SSL=1
OWNER_TG_ID=6826458047
ADMIN_PASSWORD=CHOOSE_A_STRONG_PASSWORD

# Channel the swap/withdraw gate checks (owner's channel).
CHANNEL_USERNAME=F67Drop
CHANNEL_ID=

# Market price engine (TON per MINE). Stored as nanoTON internally.
# Start 0.0001 TON, floor 0.00005 TON, cap 0.0005 TON per MINE.
PRICE_START_NANO=100000
PRICE_FLOOR_NANO=50000
PRICE_CAP_NANO=500000

# Mining (MINE per hour, daily cap)
MINING_RATE_PER_HOUR=7
DAILY_CAP_MINE=200
SWAP_MIN_MINE=10000

# Ads (placeholders until the owner pastes real publisher IDs)
MONETAG_ID=
MONETAG_SDK_SRC=
ADSTERRA_ID=
ADSTERRA_INVOKE_DOMAIN=www.highperformanceformat.com
ADSGRAM_BLOCK_ID=
GIGAPUB_ID=
AD_REWARD_MINE=10
AD_DAILY_CAP=10
